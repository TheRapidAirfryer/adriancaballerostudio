# URL pública del sitio (sin barra final). Se usa para canonical, sitemap,
# robots.txt y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.adriancaballerostudio.com

# --- Analítica (opcional) ---
# Deja en blanco cualquiera que no vayas a usar: el sitio no carga ningún
# script de analítica hasta que su variable tenga un valor real.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Meta tag de verificación de Google Search Console (el valor "content" que
# te da Search Console al verificar el sitio por meta tag HTML).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Formulario de contacto ---
# Para que el formulario ENVÍE CORREOS de verdad, usa UNA de estas dos
# opciones (no ambas). Sin ninguna configurada, el formulario sigue
# funcionando pero no envía ningún correo.

# Opción A — SMTP de tu hosting (ej. Hostinger), usando la cuenta de correo
# contacto@adriancaballero.studio que ya tienes creada ahí:
#   1. En hPanel de Hostinger: Correo electrónico > selecciona la cuenta >
#      "Configurar cliente de correo electrónico" para ver estos datos.
#   2. SMTP_HOST suele ser algo como smtp.hostinger.com
#   3. SMTP_PORT: 465 (con SSL) — es el valor por defecto si lo dejas vacío.
#   4. SMTP_USER es la dirección completa del correo; SMTP_PASS su contraseña.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Opción B — Resend (alternativa si no quieres usar el SMTP del hosting):
# crea una cuenta gratis en https://resend.com, verifica el dominio
# adriancaballero.studio con sus instrucciones de DNS, y pega aquí tu API key.
RESEND_API_KEY=

# A dónde llegan los leads. Si se deja en blanco, se usa el correo de
# src/lib/site-config.ts (contacto@adriancaballero.studio).
CONTACT_TO_EMAIL=

# Remitente del correo. Con SMTP, se usa SMTP_USER si lo dejas vacío. Con
# Resend, debe ser una dirección de un dominio verificado ahí; mientras no
# lo verifiques, deja esta variable vacía para usar la dirección de pruebas
# de Resend (onboarding@resend.dev), que solo entrega a tu propia cuenta.
CONTACT_FROM_EMAIL=

# Último respaldo: URL de un webhook (Zapier, Make, endpoint propio) al que
# reenviar cada lead si no hay SMTP ni Resend configurados. Si nada de esto
# está definido, los leads quedan registrados en el log del servidor.
CONTACT_WEBHOOK_URL=
