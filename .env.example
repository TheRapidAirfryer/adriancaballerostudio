# URL pública del sitio (sin barra final). Se usa para canonical, sitemap,
# robots.txt y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.adriancaballerostudio.com

# --- Analítica (opcional) ---
# Deja en blanco cualquiera que no vayas a usar: el sitio no carga ningún
# script de analítica hasta que su variable tenga un valor real.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Meta tag de verificación de Google Search Console (el valor "content" que
# te da Search Console al verificar el sitio por meta tag HTML).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Formulario de contacto ---
# Para que el formulario ENVÍE CORREOS de verdad, crea una cuenta gratis en
# https://resend.com, verifica tu dominio (adriancaballero.studio) siguiendo
# sus instrucciones de DNS, y pega aquí tu API key. Sin esta variable, el
# formulario sigue funcionando pero no envía ningún correo.
RESEND_API_KEY=

# A dónde llegan los leads. Si se deja en blanco, se usa el correo de
# src/lib/site-config.ts (contacto@adriancaballero.studio).
CONTACT_TO_EMAIL=

# Remitente del correo. Debe ser una dirección de un dominio verificado en
# Resend (ej. notificaciones@adriancaballero.studio). Mientras el dominio no
# esté verificado, deja el valor por defecto de pruebas de Resend
# (onboarding@resend.dev), que solo entrega al correo de tu propia cuenta.
CONTACT_FROM_EMAIL=

# Alternativa/respaldo: URL de un webhook (Zapier, Make, endpoint propio) al
# que reenviar cada lead si no hay RESEND_API_KEY configurada. Si ninguna de
# las dos está definida, los leads quedan registrados en el log del servidor.
CONTACT_WEBHOOK_URL=
